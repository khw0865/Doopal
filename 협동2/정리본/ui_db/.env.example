# Flask
FLASK_SECRET_KEY=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-admin-password
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Redis connection used by app.py, seed_demo.py, and ros_object_bridge.py
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=default
REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_SSL=false

# Optional demo objects. Fixed waypoints/cases are version-migrated automatically.
SEED_DEMO_OBJECTS=false

# Redis에 저장하지 않는 관리자 런타임 로그 파일
RUNTIME_LOG_FILE=runtime_logs.jsonl
RUNTIME_LOG_MAX_BYTES=2097152
RUNTIME_LOG_BACKUP_COUNT=3

# /rosout에서 관리자 로그에 포함할 노드명/메시지 키워드
ROSOUT_LOG_FILTER=m0609,dsr,robot_control,hand,object_detection,redis_bridge,vla
